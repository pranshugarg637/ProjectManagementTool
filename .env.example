# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → your project → Connect (or Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https
# The "publishable" key (sb_publishable_...) or the legacy "anon" key — both are safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY

# Google AI Studio → Get API key (free). Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Any free-tier text model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
